# Copy to `.env` and fill in real values. Committed file: no secrets here.
#
# When running via docker compose, the api service reaches the db service at
# hostname `db` instead of `localhost`.

POSTGRES_USER=anomaly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=anomaly

# Local compose default. On a PaaS use the platform's injected URL; the app
# rewrites postgres:// / postgresql:// to postgresql+psycopg:// automatically.
DATABASE_URL=postgresql+psycopg://anomaly:change-me@localhost:5432/anomaly

# Comma-separated browser origins allowed to call the API (no trailing slash).
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Optional regex for dynamic origins, e.g. Vercel preview URLs:
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Logging: DEBUG | INFO | WARNING | ERROR (default INFO)
LOG_LEVEL=INFO

# development | production
ENVIRONMENT=development

# --- LLM narrative layer (optional; off by default) -------------------------
# When disabled the API works normally and the dashboard hides the AI card.
LLM_ENABLED=false
# OpenAI-compatible base URL of the vLLM server, e.g. Modal:
# LLM_BASE_URL=https://<workspace>--<app>-serve.modal.run/v1
LLM_BASE_URL=
# Sent as `Authorization: Bearer ...`. With Modal proxy auth this is the Modal
# proxy token; the vLLM server behind it must NOT also set --api-key.
LLM_API_KEY=
# Must match the server's --served-model-name.
LLM_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-BF16
# Per-request timeout; sized to absorb a scale-to-zero cold start.
LLM_TIMEOUT_SECONDS=300
# Minimum seconds between forced regenerations (?refresh=true) per upload.
LLM_REFRESH_COOLDOWN_SECONDS=300

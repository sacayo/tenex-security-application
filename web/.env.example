# Copy to `.env.local` for local Next.js. Never prefix these with NEXT_PUBLIC_.
# The login gate is OFF unless all three AUTH_ values are set; when on, /login
# is public and every other route requires the session cookie.

# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional UI-only gate (Vercel production should set these):
# AUTH_USERNAME=demo
# AUTH_PASSWORD=choose-a-strong-password
# AUTH_SECRET=   # openssl rand -hex 32
